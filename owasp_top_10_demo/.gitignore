# OWASP Demo .gitignore
# This shows what should NEVER be committed to version control

# 🔒 SECURITY: NEVER commit these files
.env
.env.local
.env.*.php
secrets.json
credentials.json
*.pem
*.key
*.pub

# Potentially sensitive configuration
config/database.php
config/jwt.php
backend/config.php

# Uploaded files (could contain sensitive data)
uploads/*
!uploads/.gitkeep

# Logs that might contain sensitive information
*.log
logs/

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Build and dependency files
node_modules/
vendor/
composer.lock
package-lock.json
yarn.lock

# Development/test files
test/coverage/
.phpunit.cache
