# OWASP Top 10 Vulnerable Demo - Environment Variables
# This file demonstrates what should be in .env (but should NEVER be committed to git)
# The vulnerable app has hardcoded these values in HTML and JavaScript!

# Database Configuration
DB_HOST=localhost
DB_NAME=joblink_demo
DB_USER=root
DB_PASS=password123

# JWT Configuration
JWT_SECRET=super_secret_key_12345_exposed_in_source
JWT_ACCESS_EXPIRES=900
JWT_REFRESH_EXPIRES=604800

# API Configuration
API_KEY=api_key_12345_exposed
API_URL=http://localhost:8000/backend/

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# Application Settings
APP_ENV=development
APP_DEBUG=true
APP_NAME=JobLink

# ⚠️ VULNERABILITY DEMONSTRATION:
# In the vulnerable demo app, ALL of these values are exposed:
# 1. Hardcoded in admin.html (Database credentials)
# 2. In admin.html JavaScript (API keys and JWT secret)
# 3. In console logs and debug messages
# 4. In comments throughout the code
# 5. In error messages

# 🔒 SECURE ALTERNATIVE:
# In production, these should be:
# 1. Stored in .env file (NOT committed to git)
# 2. Loaded via environment variables at runtime
# 3. Never hardcoded in source code
# 4. Rotated regularly
# 5. Restricted to minimal permissions
# 6. Stored in secrets management system (Azure Key Vault, AWS Secrets Manager)

# Example of how to use in PHP:
# $db_host = $_ENV['DB_HOST'] ?? getenv('DB_HOST');
# $db_pass = $_ENV['DB_PASS'] ?? getenv('DB_PASS');
# $api_key = $_ENV['API_KEY'] ?? getenv('API_KEY');

# NEVER do this:
# const API_KEY = 'api_key_12345_exposed';  // VULNERABLE
# <input value="password123">               // VULNERABLE
