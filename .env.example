# Environment configuration for EmploySmart
# Copy this file to .env and replace placeholder values.

DB_HOST=localhost
DB_USER=root
DB_PASS=
DB_NAME=employsmart

JWT_SECRET=replace_with_a_strong_random_secret
JWT_ACCESS_EXPIRE=900
JWT_REFRESH_EXPIRE=604800

CORS_ALLOWED_ORIGINS=http://localhost,http://127.0.0.1,http://192.168.83.250
CORS_ALLOW_EMPTY_ORIGIN=true
