# Environment configuration for EmploySmart
# Copy this file to .env and replace placeholder values.
# For Hostinger deployment, see HOSTINGER_DEPLOYMENT_GUIDE.md

# Database Configuration
DB_HOST=localhost
DB_USER=root
DB_PASS=
DB_NAME=employsmart

# JWT Configuration
JWT_SECRET=replace_with_a_strong_random_secret_min_32_chars
JWT_ACCESS_EXPIRE=900
JWT_REFRESH_EXPIRE=604800

# CORS Configuration (Security)
# In production, set these to your actual domain
# Example: CORS_ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
CORS_ALLOWED_ORIGINS=http://localhost,http://127.0.0.1,http://localhost:5173
CORS_ALLOW_EMPTY_ORIGIN=false

# Frontend Configuration
VITE_API_URL=

# Application Environment
APP_ENV=development
APP_DEBUG=true

# Persistent data (uploads, resumes). On Hostinger this defaults to the
# "employsmart_private" folder next to public_html, which redeploys never touch.
# Put this .env file in that folder too. Leave empty unless you need another path.
DATA_DIR=

# Resume processing (see DEPLOYMENT.md)
# Absolute path OUTSIDE public_html is strongly recommended in production,
# e.g. /home/u123456789/employsmart_private/resumes. Empty = server/storage/resumes.
RESUME_STORAGE_DIR=
RESUME_MAX_SIZE_MB=5
RESUME_MAX_PAGES=10
# auto = use poppler's pdftotext as a fallback only if the server allows shell_exec.
RESUME_USE_PDFTOTEXT=auto

# Optional AI-assisted resume reading (Claude API). Off unless explicitly enabled.
# The key stays on the server; it is never sent to the browser.
RESUME_AI_ENABLED=false
ANTHROPIC_API_KEY=
RESUME_AI_MODEL=claude-opus-5-5
RESUME_AI_TIMEOUT=60

# Municipality defaults (can be changed later in Admin → Municipality Settings)
APP_MUNICIPALITY_NAME=
APP_MUNICIPALITY_PROVINCE=
APP_CONTACT_ADDRESS=
APP_OFFICE_HOURS=Monday–Friday, 8:00 AM – 5:00 PM
